{
  "name": "bulls-and-cows",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.cjs --max-warnings 0",
    "format": "prettier --check .",
    "test": "jest --passWithNoTests",
    "prepare": "husky"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{json,md,html,css,cjs}": "prettier --check"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.1.6",
    "prettier": "3.2.5",
    "ts-jest": "29.2.5",
    "typescript": "5.5.4"
  }
}
